{
  "manifest_version": 3,
  "name": "Zylos Browser Remote",
  "version": "0.2.0",
  "description": "Chat with Zylos in the side panel while it drives the site you asked about. Payment and account-settings pages are refused regardless of what is asked.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Zylos: open the chat panel"
  }
}
